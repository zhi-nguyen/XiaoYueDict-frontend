# Backend API Gateway (Cloud VPS via Cloudflare)
NEXT_PUBLIC_API_URL=https://api.cnendict.xyz

# WebSocket URL (secure WebSocket through Cloudflare)
NEXT_PUBLIC_WS_URL=wss://api.cnendict.xyz/ws
